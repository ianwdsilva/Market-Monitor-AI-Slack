# Alpaca API Credentials
# Get your keys at https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use https://api.alpaca.markets for live

# Slack Webhook
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Watchlist (comma-separated tickers)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,AMD,NFLX,DIS

# Monitoring Settings
POLL_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=60

# Strategy Settings
SIGNAL_CONFIDENCE_THRESHOLD=0.75
MIN_CONFIRMATIONS=3
BACKTEST_DAYS=30

# Logging
LOG_LEVEL=INFO
